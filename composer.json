{
  "name": "videxo/videxo-php",
  "description": "The PHP client of the Videxo API: hosted ffmpeg jobs over HTTP.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "videxo",
    "ffmpeg",
    "video",
    "transcoding",
    "api",
    "sdk"
  ],
  "homepage": "https://videxo.io/docs/sdk/php",
  "support": {
    "docs": "https://videxo.io/docs/sdk/php",
    "issues": "https://github.com/videxo-io/videxo-php/issues",
    "source": "https://github.com/videxo-io/videxo-php"
  },
  "authors": [
    {
      "name": "Videxo",
      "email": "oss@videxo.io",
      "homepage": "https://videxo.io"
    }
  ],
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.8 || ^8.0",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.1",
    "psr/http-message": "^1.1 || ^2.0"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "Videxo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Videxo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "check": [
      "@analyse",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
